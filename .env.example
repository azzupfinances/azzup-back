# Single environment file for Docker Compose and Laravel.
# Copy to .env. See docs/infrastructure/docker.md

# Docker Compose
UID=1000
GID=1000
APP_PORT=8000
DB_FORWARD_PORT=5432
MAILPIT_UI_PORT=8025

# Application
APP_NAME=Azzup
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Trusted proxies (config/trustedproxy.php): addresses allowed to report the client IP via
# X-Forwarded-For. In production, set only the web front end server's address. In development,
# requests from the host arrive from Docker's bridge gateway, inside this range.
TRUSTED_PROXIES=172.16.0.0/12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=azzup
DB_USERNAME=azzup
DB_PASSWORD=secret

# Session, cache, queue
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail (Mailpit in development)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@azzup.local
MAIL_FROM_NAME=Azzup
